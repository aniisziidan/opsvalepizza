# Site address is a bare hostname so Caddy provisions TLS automatically (Let's Encrypt/ZeroSSL)
# on :443 and auto-redirects :80 → :443. Set DOMAIN in .env.production for the real host.
{$DOMAIN:opsvale.eu} {
    encode gzip zstd

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Static Cache Optimization for Next.js immutable assets
    @static {
        path /_next/static/*
        path /favicon.ico
        path /robots.txt
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Reverse proxy to Next.js application container.
    # Cloudflare fronts this origin (DNS proxied / orange-cloud), so it supplies:
    #   - CF-Connecting-IP : the true visitor IP -> forwarded as X-Forwarded-For for rate limiting
    #   - CF-IPCountry     : ISO country code    -> passed through unchanged; read by lib/analytics/geoResolver
    # Production traffic MUST arrive via Cloudflare — lock the origin firewall to Cloudflare's IP
    # ranges so nothing can hit the origin directly and spoof these headers.
    reverse_proxy app:3000 {
        header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    # Logging
    log {
        output stdout
        format json
    }
}
