generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(SUPER_ADMIN)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  activities        LeadActivity[]
  pricingAuditLogs  PricingAuditLog[]
  actorAuditLogs    AdminAuditLog[]          @relation("ActorAdminLogs")
  targetAuditLogs   AdminAuditLog[]          @relation("TargetAdminLogs")
  notifications     Notification[]
  preferences       NotificationPreference[]
  pushSubscriptions PushSubscription[]
}

enum Role {
  SUPER_ADMIN
  SALES
  PRICING
  VIEWER
}

model Country {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  active         Boolean         @default(true)
  cities         City[]
  landedCosts    LandedCost[]
  pricingRules   PricingRule[]
  logisticsCosts LogisticsCost[]
}

model City {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  active    Boolean @default(true)

  @@index([countryId])
}

model BoxConfig {
  id           String        @id @default(cuid())
  sizeLabel    String
  lengthMm     Int?
  widthMm      Int?
  heightMm     Int?
  material     Material
  print        PrintType
  active       Boolean       @default(true)
  landedCosts  LandedCost[]
  pricingRules PricingRule[]

  @@unique([sizeLabel, material, print])
}

enum Material {
  KRAFT
  WHITE
}

enum PrintType {
  PLAIN
  PRINTED
}

model PricingRule {
  id            String    @id @default(cuid())
  scope         RuleScope
  countryId     String?
  country       Country?  @relation(fields: [countryId], references: [id])
  boxConfigId   String?
  boxConfig     BoxConfig? @relation(fields: [boxConfigId], references: [id])
  markupMin     Decimal   @db.Decimal(4, 3)
  markupMax     Decimal   @db.Decimal(4, 3)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  @@index([countryId])
  @@index([boxConfigId])
}

enum RuleScope {
  GLOBAL
  COUNTRY
  PRODUCT
}

model LandedCost {
  id            String     @id @default(cuid())
  boxConfigId   String
  boxConfig     BoxConfig  @relation(fields: [boxConfigId], references: [id])
  countryId     String
  country       Country    @relation(fields: [countryId], references: [id])
  qtyTierMin    Int
  qtyTierMax    Int?
  costEur       Decimal    @db.Decimal(10, 4)
  source        CostSource
  effectiveFrom DateTime   @default(now())
  effectiveTo   DateTime?
  active        Boolean    @default(true)

  @@index([countryId])
  @@index([boxConfigId])
}

enum CostSource {
  MANUAL
  DYNAMIC
}

model PublicPriceRange {
  id               String    @id @default(cuid())
  boxConfigId      String
  countryId        String
  minEur           Decimal   @db.Decimal(10, 4)
  maxEur           Decimal   @db.Decimal(10, 4)
  isManualOverride Boolean   @default(false)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  active           Boolean   @default(true)

  @@index([boxConfigId, countryId, active])
  @@index([countryId])
}

enum PricingEntityType {
  LANDED_COST
  PRICING_RULE
  PUBLIC_PRICE_RANGE
  LOGISTICS_COST
}

enum PricingAuditAction {
  CREATE
  VERSION_UPDATE
  TOGGLE_ACTIVE
  RETIRE
}

model PricingAuditLog {
  id         String             @id @default(cuid())
  authorId   String?
  author     AdminUser?         @relation(fields: [authorId], references: [id])
  entityType PricingEntityType
  entityId   String
  action     PricingAuditAction
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime           @default(now())

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([createdAt])
}

model LogisticsCost {
  id         String   @id @default(cuid())
  countryId  String
  country    Country  @relation(fields: [countryId], references: [id])
  route      String?
  port       String?
  shipMethod String?
  freightEur Decimal? @db.Decimal(10, 4)
  inlandEur  Decimal? @db.Decimal(10, 4)
  otherEur   Decimal? @db.Decimal(10, 4)
  active     Boolean  @default(true)

  @@index([countryId])
}

model Company {
  id                      String    @id @default(cuid())
  name                    String
  normalizedName          String    @default("")
  website                 String?
  normalizedWebsiteDomain String?
  countryCode             String?
  branchCount             Int?
  branchRange             String?
  branchCountMin          Int?
  branchCountMax          Int?
  contacts                Contact[]
  leads                   Lead[]

  @@index([normalizedWebsiteDomain])
  @@index([normalizedName, countryCode])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String
  phone     String?
  jobTitle  String?
  leads     Lead[]

  @@index([companyId])
}

model LeadSequence {
  year          Int @id
  currentNumber Int @default(0)
}

model TemporaryUpload {
  id         String       @id @default(cuid())
  token      String       @unique @default(uuid())
  storageKey String       @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  status     UploadStatus @default(TEMPORARY)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  @@index([status, expiresAt])
}

enum UploadStatus {
  TEMPORARY
  ATTACHED
  EXPIRED
}

model Lead {
  id             String              @id @default(cuid())
  code           String              @unique
  idempotencyKey String?             @unique
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  contactId      String
  contact        Contact             @relation(fields: [contactId], references: [id])
  status         LeadStatus          @default(NEW)
  source         String              @default("quote")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  calcData       CalculatorSnapshot?
  quoteRequest   QuoteRequest?
  quotes         Quote[]
  activities     LeadActivity[]
  files          StoredFile[]

  @@index([status])
  @@index([companyId])
  @@index([contactId])
}

enum LeadStatus {
  NEW
  REVIEWING
  NEED_MORE_INFO
  QUOTE_PREPARED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

model CalculatorSnapshot {
  id                  String   @id @default(cuid())
  leadId              String   @unique
  lead                Lead     @relation(fields: [leadId], references: [id])
  countryCode         String
  boxSize             String
  material            Material
  print               PrintType
  boxesPerOrder       Int
  monthlyVolume       Int
  currentPrice        Decimal  @db.Decimal(10, 4)
  landedCostEur       Decimal? @db.Decimal(10, 4)
  markupMin           Decimal? @db.Decimal(4, 3)
  markupMax           Decimal? @db.Decimal(4, 3)
  estMinEur           Decimal  @db.Decimal(10, 4)
  estMaxEur           Decimal  @db.Decimal(10, 4)
  estYearlySavings    Decimal  @db.Decimal(12, 2)
  estYearlySavingsMin Decimal? @db.Decimal(12, 2)
  estYearlySavingsMax Decimal? @db.Decimal(12, 2)
  landedCostId        String?
  markupRuleId        String?
  publicPriceRangeId  String?
  pricingVersion      String?
  productCostEur        Decimal? @db.Decimal(10, 4)
  logisticsCostId       String?
  logisticsCorridorName String?
  freightEur            Decimal? @db.Decimal(10, 4)
  inlandEur             Decimal? @db.Decimal(10, 4)
  otherEur             Decimal? @db.Decimal(10, 4)
  logisticsTotalEur     Decimal? @db.Decimal(10, 4)
  effectiveLandedEur    Decimal? @db.Decimal(10, 4)
  createdAt           DateTime @default(now())
}

enum BoxSpecType {
  STANDARD
  CUSTOM
}

model QuoteRequest {
  id                   String       @id @default(cuid())
  leadId               String       @unique
  lead                 Lead         @relation(fields: [leadId], references: [id])
  boxSpecificationType BoxSpecType  @default(STANDARD)
  standardBoxSize      String?
  lengthMm             Int
  widthMm              Int
  heightMm             Int
  material             Material
  print                PrintType
  customFlute          String?
  monthlyVolume        Int          @default(0)
  qtyPerOrder          Int
  deliveryCountryCode  String
  deliveryCity         String
  deliveryFrequency    String?
  hasLoadingDock       Boolean      @default(false)
  deliveryAccessNotes  String?
  notes                String?
  submittedAt          DateTime     @default(now())
  files                StoredFile[]
}

model Quote {
  id              String        @id @default(cuid())
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  revision        Int
  unitPriceEur    Decimal       @db.Decimal(10, 4)
  qty             Int
  specs           String?
  notes           String?
  paymentTerms    String?
  dispatchSla     String?
  snapshot        Json?
  pricingSnapshot Json?
  accessToken     String?       @unique
  dispatchReqAt   DateTime?
  sentAt          DateTime?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  status          QuoteStatus   @default(DRAFT)
  createdAt       DateTime      @default(now())
  outboxEmails    OutboxEmail[]

  @@unique([leadId, revision])
  @@index([leadId])
  @@index([accessToken])
}

enum QuoteStatus {
  DRAFT
  DISPATCHING
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model OutboxEmail {
  id        String       @id @default(cuid())
  quoteId   String?
  quote     Quote?       @relation(fields: [quoteId], references: [id])
  to        String
  from      String
  subject   String
  text      String
  html      String?
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
  @@index([quoteId])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id])
  authorId  String?
  author    AdminUser?   @relation(fields: [authorId], references: [id])
  type      ActivityType
  content   String
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([authorId])
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  QUOTE_CREATED
  QUOTE_REVISED
  QUOTE_DISPATCHED
  CUSTOMER_RESPONSE
  FILE_UPLOAD
  SUBMISSION
  EMAIL
  SYSTEM
}

model StoredFile {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id])
  quoteRequestId String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  storageKey     String        @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime      @default(now())

  @@index([leadId])
  @@index([quoteRequestId])
}

enum AdminAuditAction {
  ADMIN_CREATED
  ADMIN_ROLE_CHANGED
  ADMIN_ACTIVATED
  ADMIN_DEACTIVATED
  ADMIN_PASSWORD_RESET
}

model AdminAuditLog {
  id            String           @id @default(cuid())
  actorAdminId  String
  actorAdmin    AdminUser        @relation("ActorAdminLogs", fields: [actorAdminId], references: [id])
  targetAdminId String
  targetAdmin   AdminUser        @relation("TargetAdminLogs", fields: [targetAdminId], references: [id])
  action        AdminAuditAction
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime         @default(now())

  @@index([targetAdminId])
  @@index([actorAdminId])
  @@index([createdAt])
}

model Notification {
  id         String               @id @default(cuid())
  userId     String?
  user       AdminUser?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  category   NotificationCategory
  priority   NotificationPriority @default(NORMAL)
  title      String
  message    String
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([userId, readAt, createdAt])
  @@index([category, priority])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id          String               @id @default(cuid())
  userId      String
  user        AdminUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    NotificationCategory
  inApp       Boolean              @default(true)
  browserPush Boolean              @default(true)
  email       Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model PushSubscription {
  id         String     @id @default(cuid())
  userId     String
  user       AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String     @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lastUsedAt DateTime?

  @@index([userId])
}

model SystemIncident {
  id          String    @id @default(cuid())
  incidentKey String    @unique
  title       String
  lastAlertAt DateTime  @default(now())
  count       Int       @default(1)
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([incidentKey, resolved])
}

enum NotificationType {
  CUSTOMER_REPLY_RECEIVED
  QUOTE_REQUEST_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PROPOSAL_EXPIRING
  PROPOSAL_EXPIRED
  DOCUMENT_UPLOADED
  PRICING_IMPORT_COMPLETED
  PRICING_IMPORT_FAILED
  PRICING_VERSION_CONFLICT
  LOGISTICS_CONFIGURATION_ALERT
  SYSTEM_HEALTH_ALERT
  DATABASE_UNAVAILABLE
  BACKUP_FAILED
  EMAIL_DELIVERY_FAILED
  PDF_GENERATION_FAILED
  SYSTEM_RECOVERED
  ANALYTICS_TRAFFIC_ANOMALY
  ANALYTICS_CONVERSION_DROP
  ANALYTICS_TRAFFIC_OPPORTUNITY
}

enum NotificationCategory {
  CUSTOMER_ACTIVITY
  PROPOSAL
  QUOTE
  PRICING
  LOGISTICS
  SYSTEM
  SECURITY
  ANALYTICS
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

// ------------------------------------------------------------------------------
// PHASE 9: VISITOR INTELLIGENCE & PRIVACY-AWARE ANALYTICS
// ------------------------------------------------------------------------------

model Visitor {
  id             String           @id @default(cuid())
  anonymousId    String           @unique
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  countryCode    String?
  locale         String?
  totalVisits    Int              @default(1)
  quoteSubmitted Boolean          @default(false)
  sessions       VisitorSession[]
  events         AnalyticsEvent[]

  @@index([lastSeenAt])
  @@index([countryCode])
  @@index([firstSeenAt])
}

model VisitorSession {
  id              String            @id @default(cuid())
  visitorId       String
  visitor         Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionToken    String            @unique
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  lastActivityAt  DateTime          @default(now())
  durationSeconds Int               @default(0)
  pageViewsCount  Int               @default(1)
  entryPath       String
  exitPath        String?
  countryCode     String?
  countryName     String?
  locale          String?
  trafficSource   TrafficSourceType @default(DIRECT)
  referrerDomain  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  deviceType      DeviceType        @default(DESKTOP)
  browser         String?
  os              String?
  isBounce        Boolean           @default(true)
  events          AnalyticsEvent[]

  @@index([startedAt])
  @@index([lastActivityAt])
  @@index([countryCode, startedAt])
  @@index([trafficSource, startedAt])
  @@index([visitorId, startedAt])
  @@index([utmCampaign, startedAt])
}

model AnalyticsEvent {
  id            String             @id @default(cuid())
  visitorId     String?
  visitor       Visitor?           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       VisitorSession?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType     AnalyticsEventType
  path          String
  canonicalPath String
  locale        String?
  countryCode   String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([canonicalPath, createdAt])
  @@index([countryCode, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
}

enum AnalyticsEventType {
  PAGE_VIEW
  SESSION_START
  CALCULATOR_OPENED
  CALCULATOR_USED
  CALCULATOR_COMPLETED
  QUOTE_PAGE_OPENED
  QUOTE_REQUEST_STARTED
  QUOTE_REQUEST_SUBMITTED
  PRODUCT_VIEWED
  CTA_CLICKED
  PROPOSAL_PAGE_VIEWED
  PROPOSAL_ACCEPTED
  FILE_DOWNLOAD
}

enum TrafficSourceType {
  DIRECT
  ORGANIC_SEARCH
  REFERRAL
  SOCIAL
  PAID
  OTHER
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}



