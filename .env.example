# ==============================================================================
# OpsVale Wholesale Pizza Box Platform - Environment Configuration Template
# Copy this file to .env or .env.local and populate with your environment values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (Required)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (connection pooling recommended in prod)
DATABASE_URL="postgresql://opsvale_user:your_secure_password@localhost:5432/opsvale?schema=public"

# Auth.js / NextAuth encryption secret (generate with: openssl rand -base64 32)
AUTH_SECRET="generate-a-strong-32-byte-base64-secret-here"

# Canonical public base URL (used for email portal links, PDF headers, sitemaps)
APP_URL="http://localhost:3000"

# Deployment environment: 'production' | 'staging' | 'development'
APP_ENV="development"

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE CONFIGURATION (Local Disk vs Cloud S3/R2)
# ------------------------------------------------------------------------------
# Storage mode: 'local' (development) | 's3' (production AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER="local"

# S3 Configuration (Required if STORAGE_PROVIDER="s3")
S3_BUCKET="opsvale-packaging-uploads"
S3_REGION="eu-central-1"
S3_ENDPOINT="" # Optional custom endpoint for Cloudflare R2 or MinIO
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_FORCE_PATH_STYLE="false" # Set 'true' for MinIO or local S3 emulators

# ------------------------------------------------------------------------------
# 3. EMAIL DISPATCHER CONFIGURATION (Console Logger vs Production SMTP)
# ------------------------------------------------------------------------------
# If SMTP_HOST is omitted, emails are logged to server console in development.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
ADMIN_NOTIFY_EMAIL="procurement@opsvale.com"

# ------------------------------------------------------------------------------
# 4. CRON & OPERATIONAL SECURITY (Required for automated cleanup)
# ------------------------------------------------------------------------------
# Bearer token for authenticating scheduled cron jobs (e.g. /api/cron/cleanup-uploads)
CRON_SECRET="generate-a-strong-random-cron-bearer-token"

# Set to "true" if running behind a reverse proxy (Nginx, Traefik, AWS ALB)
TRUST_PROXY="false"
