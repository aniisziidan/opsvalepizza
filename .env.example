# OpsVale environment configuration
# Copy to .env.local for local development.

# APP_URL: Public base URL of the app. Used for self-referential links.
APP_URL="http://localhost:3000"

# Phase 1: PostgreSQL (Prisma) + Auth.js
DATABASE_URL="postgresql://opsvale:opsvale@localhost:5432/opsvale?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Phase 3: Email (Nodemailer/SMTP) & Security
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"
ADMIN_NOTIFY_EMAIL="admin@opsvale.com"
CRON_SECRET="change-this-to-a-secure-random-secret"
TRUST_PROXY="false"
